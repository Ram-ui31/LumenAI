# Copy to backend/.env and `source .env` before running the API on your own machine.
# Secrets are NOT stored here: Hugging Face login is `hf auth login`; on Modal the keys live in Modal secrets.

# where Hugging Face models are cached (~30 GB)
export HF_HOME="$PWD/.hf_cache"

# cuda | mps | cpu (auto-detected when unset)
# export ADOBEPS_DEVICE=cuda

# stub = no models at all (used by the tests and the demo server)
# export ADOBEPS_BACKEND=stub

# Trends tool (optional): your Gemini API key
# export GEMINI_API_KEY=...
